# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 1
  metrics: count: path: 3
  metrics: count: method: 3

  entity: quote: {
    path: "/v1/quotes": {
      op: list: method: *GET
    }
    path: "/v1/quotes/search/{searchTerm}": {
      rename: param: "searchTerm": *"search_term"
      op: load: method: *GET
    }
    path: "/v1/quotes/{number}": {
      rename: param: "number": *"id"
      op: load: method: *GET
    }
  }

}