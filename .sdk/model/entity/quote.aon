# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: [
    {
      name: "character"
      req: true
      short: "The character who said the quote"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "quote"
      req: true
      short: "The quote text from South Park"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/v1/quotes"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 3
                kind: "param"
                name: "id"
                orig: "number"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/quotes/{number}"
          rename: {
            param: {
              number: "id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "randy"
                kind: "param"
                name: "search_term"
                orig: "search_term"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/quotes/search/{searchTerm}"
          rename: {
            param: {
              searchTerm: "search_term"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
            {
              lit: "search"
            }
            {
              var: "search_term"
            }
          ]
          select: {
            exist: [
              "search_term"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "search"
      ]
    ]
  }



}
