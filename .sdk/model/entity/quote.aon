# Entity: quote

main: kit: entity: quote: {

  alias: field: {}

  fields: [
    {
      name: "character"
      req: true
      short: "The character who said the quote"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "quote"
      req: true
      short: "The quote text from South Park"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "quote"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /v1/quotes"
            json: "{\"operationId\":\"getRandomQuote\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"character\":\"Stan\",\"quote\":\"Don't you dare call me a Cartman!\"}],\"schema\":{\"items\":{\"properties\":{\"character\":{\"description\":\"The character who said the quote\",\"type\":\"string\"},\"quote\":{\"description\":\"The quote text from South Park\",\"type\":\"string\"}},\"required\":[\"quote\",\"character\"],\"type\":\"object\"},\"maxItems\":1,\"minItems\":1,\"type\":\"array\"}}},\"description\":\"A random South Park quote\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/quotes"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 3
                kind: "param"
                name: "id"
                orig: "number"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /v1/quotes/{number}"
            json: "{\"operationId\":\"getMultipleQuotes\",\"parameters\":[{\"description\":\"The number of quotes to retrieve\",\"in\":\"path\",\"name\":\"number\",\"required\":true,\"schema\":{\"example\":3,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"character\":\"Cartman\",\"quote\":\"I'm not fat, I'm festively plump.\"},{\"character\":\"Butters\",\"quote\":\"But what does being Hawaiian have to do with me being like an emo chick on her period?\"},{\"character\":\"Stan\",\"quote\":\"Cartman doesn't know a rainforest from a Pop-Tart.\"}],\"schema\":{\"items\":{\"properties\":{\"character\":{\"description\":\"The character who said the quote\",\"type\":\"string\"},\"quote\":{\"description\":\"The quote text from South Park\",\"type\":\"string\"}},\"required\":[\"quote\",\"character\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"An array of South Park quotes\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/quotes/{number}"
          rename: {
            param: {
              number: "id"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                example: "randy"
                kind: "param"
                name: "search_term"
                orig: "search_term"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /v1/quotes/search/{searchTerm}"
            json: "{\"operationId\":\"searchQuotes\",\"parameters\":[{\"description\":\"The search term to filter quotes by (character name or text within quote)\",\"in\":\"path\",\"name\":\"searchTerm\",\"required\":true,\"schema\":{\"example\":\"randy\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[{\"character\":\"randy\",\"quote\":\"as you get older, boobs will start becoming a major part of your life. but you can't let them get in the way of your friends. there are a lot of boobs out there. but they're just boobs. your friends are forever.\"},{\"character\":\"randy\",\"quote\":\"we must stop frivolous spending! instead of paying for cable, let us watch clouds! instead of buying clothes, wear but sheets from thine beds! cut spending to only the bare essentials! water and bread and margaritas!\"},{\"character\":\"randy\",\"quote\":\"oh, i forgot to tell you that part. i'm lorde.\"},{\"character\":\"randy\",\"quote\":\"i ammm lorde. lawdy lawdy lorde!\"},{\"character\":\"randy\",\"quote\":\"winter's coming, sharon, and i'm a busy little bee. buzz! buzz!\"},{\"character\":\"randy\",\"quote\":\"oh, i'm sorry! i thought this was america!\"},{\"character\":\"randy\",\"quote\":\"i'm not having a glass of wine, i'm having six. it's called a tasting, and it's classy.\"}],\"schema\":{\"items\":{\"properties\":{\"character\":{\"description\":\"The character who said the quote\",\"type\":\"string\"},\"quote\":{\"description\":\"The quote text from South Park\",\"type\":\"string\"}},\"required\":[\"quote\",\"character\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"An array of matching South Park quotes\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/v1/quotes/search/{searchTerm}"
          rename: {
            param: {
              searchTerm: "search_term"
            }
          }
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "quotes"
            }
            {
              lit: "search"
            }
            {
              var: "search_term"
            }
          ]
          select: {
            exist: [
              "search_term"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "search"
      ]
    ]
  }



}
